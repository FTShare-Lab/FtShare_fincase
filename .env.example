# Build-time mode: demo (offline generated data) or live (your authorized snapshot).
DATA_MODE=demo
FTSHARE_SEED_FILE=data/private/seed.json
# Build-time feature: 1 enables the ETF activity radar.
ENABLE_RADAR=0
# Collector secret. The read-only web server does not consume it.
FTSHARE_API_KEY=
# Alternative: an explicit path to a file containing only your key.
FTSHARE_API_KEY_FILE=
FTSHARE_REQUEST_INTERVAL_MS=1000
# Node only: shared file written by the separate background collector.
FTSHARE_LIVE_CACHE_FILE=data/private/live-cache.json
HOST=127.0.0.1
PORT=8080
